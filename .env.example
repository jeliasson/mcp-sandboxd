#
# Required
#

# Sandbox container image reference (must include /workspace and /artifacts and uid 1000)
SANDBOX_IMAGE=mcp-sandboxd-sandbox:dev

#
# Backend
#

# Sandbox backend implementation.
# - docker: local Docker/Podman socket or DinD sidecar
# - kubernetes: schedule sandbox Pods via Kubernetes API
# SANDBOX_BACKEND=docker

# Kubernetes namespace to create sandbox Pods in (defaults to the server Pod's namespace).
# KUBERNETES_SANDBOX_NAMESPACE=

# Container name in sandbox Pods.
# KUBERNETES_SANDBOX_CONTAINER_NAME=sandbox

#
# Transport / HTTP
#

# PORT=8080
# MCP_PATH=/mcp
# DEBUG_UI_ENABLED=false
# LOG_HTTP_REQUESTS=false
# LOG_MCP_REQUESTS=false

#
# Artifacts
#

# ARTIFACTS_DIR=./data/artifacts

#
# Docker / Podman
#

# AUTO_BUILD_SANDBOX_IMAGE=true
# SANDBOX_DOCKERFILE_PATH=docker/sandbox.Dockerfile
# LOG_TOOLCALLS=false

# If you are on NixOS with rootless Podman, DOCKER_HOST often is:
# DOCKER_HOST=unix:///run/user/1000/podman/podman.sock

# If using a DinD sidecar (kubernetes-style), set something like:
# DOCKER_HOST=tcp://dind:2375
# DOCKER_TLS_VERIFY=0
# DOCKER_CERT_PATH=

#
# Sandbox Policy
#

# Network mode for sandbox containers.
# SANDBOX_NETWORK_MODE=bridge

# Use Docker's no-new-privileges security option.
# SANDBOX_NO_NEW_PRIVILEGES=true

# Linux capabilities (Docker format, e.g. SETUID, CHOWN, NET_ADMIN).
# CapDrop defaults to ALL; CapAdd defaults to a minimal set that enables common admin tasks.
# SANDBOX_CAP_DROP=ALL
# SANDBOX_CAP_ADD=SETUID,SETGID,CHOWN,FOWNER,DAC_OVERRIDE

# Validate capability names on startup.
# SANDBOX_CAPS_STRICT=true

# Allow unknown capability names (not recommended).
# SANDBOX_CAPS_BYPASS_CHECK=false

#
# Tool Description Overrides
#

# Allows adapting tool docs for specific deployments/clients.
# TOOL_DESC_OVERRIDES_ENABLED=true
# TOOL_DESC_RUN_SANDBOX_OVERRIDE=
# TOOL_DESC_RUN_SANDBOX_APPEND=
# TOOL_DESC_DELETE_SANDBOX_OVERRIDE=
# TOOL_DESC_DELETE_SANDBOX_APPEND=
# TOOL_DESC_RESTART_SANDBOX_OVERRIDE=
# TOOL_DESC_RESTART_SANDBOX_APPEND=

#
# TTL / Limits
#

# DEFAULT_TTL_SECONDS=3600
# MAX_TTL_SECONDS=604800
# REAPER_INTERVAL_MS=5000
# DEFAULT_CPU_CORES=1
# DEFAULT_MEMORY_MB=1024
# DEFAULT_PIDS=256
# DEFAULT_COMMAND_TIMEOUT_MS=120000
# DEFAULT_STDOUT_MAX_BYTES=1048576
# DEFAULT_STDERR_MAX_BYTES=1048576
# DEFAULT_AWAIT_COMPLETION=false
# DEFAULT_AWAIT_TIMEOUT_MS=30000

#
# Retention
#

# MAX_RUNS=10000

#
# CORS
#

# CORS_ALLOW_ORIGINS=http://localhost:6274
# (Browser clients may need access to `Mcp-Session-Id` header; server exposes it when CORS is enabled.)

#
# Denylist
#

# DENYLIST_ENABLED=true
# DENYLIST_PATTERNS=\bdocker\b,\bmount\b,\bmodprobe\b,\bnsenter\b
